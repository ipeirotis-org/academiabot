# At least one provider key is required. OpenAI is preferred (only provider with web search).
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# Optional: override the default LLM model (default: gpt-4o)
# LLM_MODEL=gpt-4o

# Optional: custom User-Agent for Wikidata API requests
# WD_BOT_USERAGENT=AcademiaBot/1.0 (your-email@example.com)
